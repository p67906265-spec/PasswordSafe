<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PasswordSafe" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryVariant">@color/blue_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/blue_dark</item>
        <item name="android:navigationBarColor">@color/page_background</item>
        <item name="android:colorAccent">@color/blue_primary</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="PasswordSafeDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="colorPrimary">#0097A7</item>
        <item name="colorAccent">#00AFC0</item>
        <item name="colorSurface">#F7FEFF</item>
        <item name="colorOnSurface">#071827</item>
        <item name="android:textColorPrimary">#071827</item>
        <item name="android:textColorSecondary">#4B6570</item>
    </style>
</resources>
